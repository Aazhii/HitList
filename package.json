{
  "name": "kaizen-todo-75utf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"vite,notes\" --prefix-colors \"cyan,green\" \"vite\" \"NODE_ENV=development pnpm run server\"",
    "dev:ui": "vite",
    "server": "node --env-file-if-exists=.env.local --import tsx server/notes-server.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint src/ --format stylish --cache",
    "preview": "vite preview",
    "start": "pnpm run build && NODE_ENV=production pnpm run server",
    "preview:server": "NODE_ENV=production pnpm run server",
    "catalyst:setup": "node --env-file-if-exists=.env.local --import tsx scripts/catalyst-setup.ts",
    "build:appsail": "pnpm run build && node scripts/build-appsail.mjs",
    "lock:npm": "rm -rf .lockgen && mkdir -p .lockgen && cp package.json .lockgen/ && npm install --package-lock-only --no-audit --no-fund --prefix .lockgen && mv .lockgen/package-lock.json package-lock.json && rm -rf .lockgen",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zcatalyst-sdk-node": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.3.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.25.0"
}
