# Kaizen Todo — Environment Variables
#
# Copy this file to .env.local and fill in values for your environment.
# Never commit .env.local to version control.

# API Base URL
# ─────────────────────────────────────────────────────────────────────────────
# Leave blank (or omit) when the frontend and API share the same origin.
# This is the correct setting for:
#   • Local dev  — Vite proxies /api → http://localhost:3001 automatically
#   • Production — the Express server serves the built frontend from the same origin
#
# Set to a full URL only when the frontend and API are on different origins, e.g.:
#   VITE_API_BASE_URL=https://api.example.com
#
VITE_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Catalyst Data Store
# ─────────────────────────────────────────────────────────────────────────────
# Leave ALL of these blank to use the JSON-file store in server/ (local dev).
#
# You do not need them when the app runs under the Catalyst gateway — AppSail,
# a Function, or `catalyst serve` — because the gateway injects the project
# credentials as request headers. Set them to reach a real Catalyst project
# from a plain `pnpm dev`.
#
# Find the project id and key in the Catalyst console under your project's
# settings. Mint the OAuth client and refresh token in the Zoho API console
# (https://api-console.zoho.com) with these scopes:
#   ZohoCatalyst.tables.rows.CREATE, .READ, .UPDATE, .DELETE
#   ZohoCatalyst.tables.READ
#
# Set them in .env.local, never here — .env.local is gitignored.

CATALYST_PROJECT_ID=
CATALYST_PROJECT_KEY=
CATALYST_ENVIRONMENT=Development
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_REFRESH_TOKEN=
# Optional, only if your project uses one:
CATALYST_PROJECT_SECRET_KEY=

# Data centre. Defaults to the US endpoint; override for EU/IN/AU/CA/JP/SA.
#   EU https://api.catalyst.zoho.eu      IN https://api.catalyst.zoho.in
#   AU https://api.catalyst.zoho.com.au  CA https://api.catalyst.zohocloud.ca
#   JP https://api.catalyst.zoho.jp      SA https://api.catalyst.zoho.sa
# X_ZOHO_CATALYST_CONSOLE_URL=https://api.catalyst.zoho.com
# X_ZOHO_CATALYST_ACCOUNTS_URL=https://accounts.zoho.com

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API cross-origin. Not needed in
# production (the server serves the built frontend from the same origin) and
# not needed in dev (Vite proxies /api). Only for split-origin deployments.
# ALLOWED_ORIGINS=https://app.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Notification delivery
# ─────────────────────────────────────────────────────────────────────────────
# None of these may be named CATALYST_* — AppSail rejects that prefix on
# user-supplied environment variables.

# Shared secret for POST /api/internal/tick, which the Catalyst cron calls to
# drain the notification queue. The endpoint refuses to run when this is unset
# rather than defaulting to open, so leaving it blank disables delivery rather
# than exposing it.
#
# Generate one and use the SAME value in both places:
#   TICK_SECRET=$(openssl rand -hex 32)
#   TICK_SECRET=$TICK_SECRET pnpm build:appsail   # bakes it into the service
#   TICK_SECRET=$TICK_SECRET pnpm catalyst:cron   # registers the cron
# TICK_SECRET=

# The zone a task's dueDate + dueTime are read in when a request carries no
# X-Timezone header. The browser sends its own on every call; this is the
# fallback for anything that does not.
# DEFAULT_TIMEZONE=Asia/Kolkata

# Sender for reminder email. Must be a sender REGISTERED in Catalyst — an
# unregistered address fails with 404 INVALID_ID "No such from_email", which
# reads like a bad route rather than a configuration problem. Unset means the
# email channel skips and the notification still arrives in-app.
# NOTIFY_FROM_EMAIL=

# Kill switch, comma-separated: email, webpush, inapp. A channel listed here is
# skipped without spending the notification's retry budget — which is the point,
# since a misconfigured channel cannot fix itself by being retried.
# NOTIFY_DISABLED_CHANNELS=

# How often the server sweeps the notification queue, in milliseconds.
# Default 5 minutes; floor 30 seconds. This is the one dial for precision
# against cost — a tick is one indexed query that usually returns nothing, so
# 288 a day per instance. Raising it to 15 minutes cuts that by two thirds.
#
# The sweep runs inside the server rather than on a Catalyst cron, because no
# Catalyst cron type will run more often than hourly. Running it on every
# AppSail instance is safe: each queue row is claimed before delivery, so
# concurrent sweeps cost a duplicate query, not a duplicate notification.
# SWEEP_INTERVAL_MS=300000

# Set to 1 to stop the server sweeping, leaving only the hourly backstop cron.
# SWEEP_DISABLED=
