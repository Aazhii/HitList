# Kaizen Todo — Environment Variables
#
# Copy this file to .env.local and fill in values for your environment.
# Never commit .env.local to version control.

# API Base URL
# ─────────────────────────────────────────────────────────────────────────────
# Leave blank (or omit) when the frontend and API share the same origin.
# This is the correct setting for:
#   • Local dev with Spring Boot on :8080 — Vite proxies /api automatically
#   • Production — Spring Boot serves the built frontend from the same origin
#
# Set to a full URL only when the frontend and API are on different origins, e.g.:
#   VITE_API_BASE_URL=https://api.example.com
#
VITE_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
# Local and deployed runtime require a PostgreSQL 9.5-compatible connection URL.
# The Spring Boot service creates its idempotent schema and indexes on startup.
# DATABASE_URL=postgres://hitlist:password@127.0.0.1:5432/hitlist
# Docker Desktop can reach a host service with host.docker.internal:
# DATABASE_URL=postgres://hitlist:password@host.docker.internal:5432/hitlist
# SERVER_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API cross-origin. Not needed in
# production (the server serves the built frontend from the same origin) and
# usually not needed in dev (Vite proxies /api). Only for split-origin deployments.
# ALLOWED_ORIGINS=https://app.example.com
# Use an at-least-32-byte high-entropy value in deployed environments so browser workspaces survive
# restarts. When omitted locally, a secure ephemeral key is generated at startup.
# OWNER_COOKIE_SECRET=
