  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:ui",
    "dev:ui": "vite",
    "server": "mvn -f ../api/pom.xml spring-boot:run",
    "build": "tsc -b && vite build",
    "lint": "eslint src/ test/ --format stylish --cache",
    "preview": "vite preview",
    "start": "pnpm run server",
    "lock:npm": "rm -rf .lockgen && mkdir -p .lockgen && cp package.json .lockgen/ && npm install --package-lock-only --no-audit --no-fund --prefix .lockgen && mv .lockgen/package-lock.json package-lock.json && rm -rf .lockgen",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "design:check": "node scripts/design-check.mjs"
  },
