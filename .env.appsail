# Build profile for the AppSail deployment, where the Express server serves the
# frontend from its own origin.
#
# VITE_API_BASE_URL is deliberately EMPTY so the app calls /api/... relative to
# whatever origin it was loaded from. An absolute URL looks equivalent but is
# strictly worse here: it breaks the moment the page is reached by any hostname
# that is not character-for-character identical — a trailing dot
# (catalystappsail.in.), a custom domain, or a production promotion — because
# the browser then treats the app's own API as cross-origin and CORS blocks it.
#
# Relative URLs are correct by construction for a same-origin deployment.
VITE_API_BASE_URL=
