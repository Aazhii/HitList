{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Run under tsx, so resolution matches the bundler-style app config */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Production runs `node server/notes-server.ts` directly, using Node's
       native type stripping (23.6+). That only handles erasable syntax, so the
       checker enforces it here — an enum, namespace or parameter property
       would run fine under tsx locally and crash the deployed server. */
    "erasableSyntaxOnly": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server", "scripts"]
}
